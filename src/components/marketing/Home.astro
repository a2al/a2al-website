---
import type { Locale } from '@/i18n/config'
import { docsPath, localizePath } from '@/i18n/paths'
import { t } from '@/i18n/strings'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const tr = t(locale)
const p = (path: string) => localizePath(locale, path)
const d = (path: string) => docsPath(locale, path)
---

<!-- 1. Hero 场景主画卷 -->
<section class="relative pt-24 pb-28 px-6 overflow-hidden">
  <!-- 背景径向渐变景深 -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[550px] bg-accent/10 rounded-full blur-[140px] pointer-events-none -z-10"></div>
  
  <div class="max-w-6xl mx-auto">
    <!-- Eyebrow -->
    <div class="flex justify-center mb-8">
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full border border-accent/30 bg-accent/5 text-accent text-xs font-mono font-medium tracking-wide">
        <span class="w-2 h-2 rounded-full bg-accent animate-ping"></span>
        {tr.home.heroEyebrow}
      </div>
    </div>

    <!-- 主张 Headline -->
    <div class="text-center max-w-4xl mx-auto mb-14">
      <h1 class="hero-title text-4xl sm:text-5xl md:text-7xl font-bold tracking-tight text-white mb-6 leading-[1.15]">
        {tr.home.heroTitleLine1}<br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent via-white to-text-secondary">
          {tr.home.heroTitleLine2}
        </span>
      </h1>
      <p class="text-base sm:text-lg md:text-xl text-text-secondary max-w-2xl mx-auto leading-relaxed">
        {tr.home.heroSubtitle}
      </p>

      <!-- 双行动 CTA -->
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={p('/quickstart')}
          class="w-full sm:w-auto px-8 py-4 bg-accent text-background font-semibold rounded-lg hover:bg-opacity-90 transition-all duration-200 shadow-[0_0_25px_rgba(0,212,170,0.35)] hover:shadow-[0_0_35px_rgba(0,212,170,0.5)] text-center text-base"
        >
          {tr.home.ctaPrimary}
        </a>
        <button
          type="button"
          id="copy-hero-prompt"
          data-prompt={tr.home.aiPromptText}
          data-copied={tr.home.ctaPromptCopied}
          class="w-full sm:w-auto px-7 py-4 border border-border hover:border-accent/60 bg-surface/80 rounded-lg text-base text-text-secondary hover:text-white transition-all flex items-center justify-center gap-2.5 cursor-pointer"
        >
          <svg class="w-5 h-5 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
          </svg>
          <span class="btn-text">{tr.home.ctaPromptBtn}</span>
        </button>
      </div>
    </div>

    <!-- 生产级拟物终端实证 -->
    <div class="max-w-3xl mx-auto rounded-xl overflow-hidden font-mono text-xs sm:text-sm border border-border/80 bg-[#080d0c] shadow-[0_20px_50px_rgba(0,0,0,0.6),0_0_40px_rgba(0,212,170,0.08)] transition-all duration-300 hover:border-accent/40 hover:shadow-[0_25px_60px_rgba(0,0,0,0.7),0_0_50px_rgba(0,212,170,0.12)]">
      <div class="bg-[#111916] px-4 py-3 border-b border-border flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-[#ff5f56]"></span>
          <span class="w-3 h-3 rounded-full bg-[#ffbd2e]"></span>
          <span class="w-3 h-3 rounded-full bg-[#27c93f]"></span>
          <span class="ml-2 text-text-secondary/60 text-xs">{tr.home.terminalTitle}</span>
        </div>
        <span class="text-text-secondary/60 text-xs flex items-center gap-1.5 font-sans">
          <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span> Connected
        </span>
      </div>

      <div class="p-5 sm:p-6 space-y-4 text-text-secondary leading-relaxed overflow-x-auto">
        <div class="text-text-secondary/50 font-sans text-xs">{tr.home.terminalStep1Comment}</div>
        <div class="flex items-center gap-2 text-white">
          <span class="text-accent font-bold select-none">$</span>
          <span>{tr.home.terminalStep1Cmd}</span>
        </div>
        <div class="text-text-secondary pl-4 space-y-1">
          <!-- 示例 AID 必须与 terminalStep2Cmd 里的一致，且是合法的 42 位（大小写是校验位） -->
          <div>{tr.home.terminalStep1Out1} <span class="text-accent font-semibold inline-block px-1.5 py-0.5 rounded bg-accent/10 border border-accent/20">A06aE78750B7f0a5975a9f455C98087902a4Ab15ca</span></div>
          <div class="text-text-secondary/80">{tr.home.terminalStep1Out2}</div>
        </div>

        <div class="text-text-secondary/50 pt-2 font-sans text-xs">{tr.home.terminalStep2Comment}</div>
        <div class="flex items-center gap-2 text-white">
          <span class="text-accent font-bold select-none">$</span>
          <span class="break-all">{tr.home.terminalStep2Cmd}</span>
        </div>

        <div class="text-text-secondary/50 pt-2 font-sans text-xs">{tr.home.terminalStep3Comment}</div>
        <div class="bg-surface/90 border border-accent/25 rounded-lg p-3.5 text-white pl-4 space-y-1.5 shadow-inner font-mono">
          <div class="text-accent font-semibold flex items-center justify-between text-xs">
            <span>{tr.home.terminalStep3RemoteName}</span>
            <span class="text-text-secondary/60 text-[11px] font-normal">[{tr.home.terminalStep3RemoteVia}]</span>
          </div>
          <div class="text-xs sm:text-sm text-white/90 break-all">{tr.home.terminalStep3RemoteMsg}</div>
        </div>
      </div>

      <!-- 底部能力微型带 -->
      <div class="bg-[#0e1614] px-4 py-3 border-t border-border/80 flex flex-wrap items-center justify-between text-xs text-text-secondary/70 gap-2">
        <span class="text-text-secondary font-semibold font-sans">{tr.home.capabilitiesLabel}</span>
        
        <!-- Fetch: Request-Response Stream -->
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-surface/80 border border-border/70 hover:border-accent/40 transition-colors">
          <svg class="w-3.5 h-3.5 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
          </svg>
          <span class="font-medium text-white/90">{tr.home.capFetch}</span>
        </span>

        <!-- Tunnel: Persistent Bi-directional Channel -->
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-surface/80 border border-border/70 hover:border-accent/40 transition-colors">
          <svg class="w-3.5 h-3.5 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 2v20m0-20L7 7m5-5l5 5m-10 10l5 5 5-5"></path>
          </svg>
          <span class="font-medium text-white/90">{tr.home.capTunnel}</span>
        </span>

        <!-- Note: Asynchronous Immutable Message -->
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-surface/80 border border-border/70 hover:border-accent/40 transition-colors">
          <svg class="w-3.5 h-3.5 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          <span class="font-medium text-white/90">{tr.home.capNote}</span>
        </span>

        <!-- Room: Encrypted Multiparty Topology -->
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-surface/80 border border-border/70 hover:border-accent/40 transition-colors">
          <svg class="w-3.5 h-3.5 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
          </svg>
          <span class="font-medium text-white/90">{tr.home.capRoom}</span>
        </span>
      </div>
    </div>
  </div>
</section>

<!-- 2. 范式对比（Paradigm Shift） -->
<section id="contrast" class="py-24 px-6 border-t border-border/50 relative">
  <div class="max-w-6xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-accent text-xs font-bold tracking-widest uppercase mb-2 block">{tr.home.contrastEyebrow}</span>
      <h2 class="display-heading text-3xl md:text-4xl font-bold text-white mb-4 text-balance">{tr.home.contrastTitle}</h2>
      <p class="text-text-secondary text-sm md:text-base leading-relaxed">{tr.home.contrastLead}</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 items-stretch">
      <!-- 对比卡片 1：传统痛点（暗哑收敛） vs A2AL（发光聚焦） -->
      <div class="bg-surface/60 border border-border/70 rounded-xl p-8 hover:border-accent/40 transition-all duration-300 flex flex-col justify-between shadow-lg relative overflow-hidden group">
        <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-red-500/30 via-transparent to-accent/40"></div>
        <div>
          <div class="mb-6">
            <span class="text-xs font-semibold px-2.5 py-1 rounded bg-red-500/10 text-red-400 border border-red-500/20">{tr.home.contrastCard1Badge}</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-4">{tr.home.contrastCard1Title}</h3>
          <ul class="text-sm text-text-secondary space-y-3 mb-8">
            {tr.home.contrastCard1Pains.map((pain) => (
              <li class="flex items-start gap-2.5">
                <span class="text-red-400/80 font-bold shrink-0">×</span>
                <span class="leading-relaxed text-text-secondary/80">{pain}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="pt-6 border-t border-border/80 bg-surface/40 -mx-8 -mb-8 p-8 rounded-b-xl">
          <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 mb-2">
            <div class="flex items-center gap-2 text-accent text-lg font-bold uppercase">
              <span class="w-2 h-2 rounded-full bg-accent shadow-[0_0_8px_#00d4aa] shrink-0"></span> {tr.home.contrastCard1GainTitle}
            </div>
            <span class="ml-auto text-xs text-text-secondary/60 font-mono tracking-wider">{tr.home.contrastCard1Tag}</span>
          </div>
          <p class="text-sm text-white font-medium leading-relaxed">{tr.home.contrastCard1GainBody}</p>
        </div>
      </div>

      <!-- 对比卡片 2：传统痛点 vs A2AL -->
      <div class="bg-surface/60 border border-border/70 rounded-xl p-8 hover:border-accent/40 transition-all duration-300 flex flex-col justify-between shadow-lg relative overflow-hidden group">
        <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-red-500/30 via-transparent to-accent/40"></div>
        <div>
          <div class="mb-6">
            <span class="text-xs font-semibold px-2.5 py-1 rounded bg-red-500/10 text-red-400 border border-red-500/20">{tr.home.contrastCard2Badge}</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-4">{tr.home.contrastCard2Title}</h3>
          <ul class="text-sm text-text-secondary space-y-3 mb-8">
            {tr.home.contrastCard2Pains.map((pain) => (
              <li class="flex items-start gap-2.5">
                <span class="text-red-400/80 font-bold shrink-0">×</span>
                <span class="leading-relaxed text-text-secondary/80">{pain}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="pt-6 border-t border-border/80 bg-surface/40 -mx-8 -mb-8 p-8 rounded-b-xl">
          <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 mb-2">
            <div class="flex items-center gap-2 text-accent text-lg font-bold uppercase">
              <span class="w-2 h-2 rounded-full bg-accent shadow-[0_0_8px_#00d4aa] shrink-0"></span> {tr.home.contrastCard2GainTitle}
            </div>
            <span class="ml-auto text-xs text-text-secondary/60 font-mono tracking-wider">{tr.home.contrastCard2Tag}</span>
          </div>
          <p class="text-sm text-white font-medium leading-relaxed">{tr.home.contrastCard2GainBody}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 3. 技术架构（Protocol Stack） -->
<section id="ecology" class="py-24 px-6 border-t border-border/50 bg-[#0c1311] relative">
  <div class="max-w-5xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-accent text-xs font-bold tracking-widest uppercase mb-2 block">{tr.home.archEyebrow}</span>
      <h2 class="display-heading text-3xl md:text-4xl font-bold text-white mb-4 text-balance">{tr.home.archTitle}</h2>
      <p class="text-text-secondary text-sm md:text-base leading-relaxed">{tr.home.archLead}</p>
    </div>

    <!-- 三层架构胶囊 -->
    <div class="grid md:grid-cols-3 gap-6">
      {tr.home.archLayers.map((layer) => (
        <div class:list={[
          'p-7 rounded-xl border relative transition-all duration-300 flex flex-col justify-between',
          layer.current
            ? 'border-2 border-accent bg-surface shadow-[0_0_35px_rgba(0,212,170,0.18)] scale-[1.02]'
            : 'border-border/80 bg-surface/40 hover:bg-surface/70'
        ]}>
          <div>
            {layer.current && (
              <div class="absolute -top-3 right-4 px-2.5 py-0.5 rounded-full bg-accent text-background text-[10px] font-extrabold uppercase tracking-wider shadow-[0_0_12px_rgba(0,212,170,0.5)]">
                You Are Here
              </div>
            )}
            <div class:list={['text-xs font-mono mb-3 tracking-wide', layer.current ? 'text-accent font-semibold' : 'text-text-secondary/60']}>
              {layer.num}
            </div>
            <h4 class="text-lg font-bold text-white mb-3">{layer.name}</h4>
          </div>
          <p class="text-xs text-text-secondary leading-relaxed mt-2">{layer.desc}</p>
        </div>
      ))}
    </div>

    <!-- 架构定论总结框 -->
    <div class="mt-12 p-5 rounded-lg border border-border/70 bg-surface/60 text-center max-w-2xl mx-auto text-sm text-text-secondary tracking-wide">
      <span class="text-white/90 font-medium">{tr.home.archSummary}</span>
    </div>
  </div>
</section>

<!-- 4. 快速开始收束（Quick Start） -->
<section id="quickstart" class="py-24 px-6 border-t border-border/50 relative">
  <div class="max-w-4xl mx-auto text-center">
    <span class="text-accent text-xs font-bold tracking-widest uppercase mb-3 block">{tr.home.actionEyebrow}</span>
    <h2 class="display-heading text-3xl md:text-5xl font-bold text-white mb-6 text-balance">{tr.home.actionTitle}</h2>
    <p class="text-text-secondary text-base mb-10 max-w-xl mx-auto">{tr.home.actionLead}</p>

    <!-- 一行 CLI 快速命令栏 -->
    <div class="max-w-xl mx-auto bg-surface border border-border rounded-lg p-2.5 flex items-center justify-between font-mono text-sm text-white mb-12 shadow-lg">
      <div class="flex items-center gap-3 pl-3 overflow-hidden text-ellipsis whitespace-nowrap">
        <span class="text-accent select-none">$</span>
        <span class="text-accent">npm</span> <span>install -g a2ald && a2ald</span>
      </div>
      <button
        type="button"
        id="copy-cli-btn"
        data-cmd={tr.home.actionCmd}
        data-copied={tr.home.actionCmdCopied}
        class="px-4 py-2.5 bg-[#1b2622] hover:bg-accent hover:text-background text-sm font-semibold rounded transition shrink-0 cursor-pointer"
      >
        <span class="btn-text">{tr.home.actionCmdBtn}</span>
      </button>
    </div>

    <!-- 双向分流出口卡片 -->
    <div class="grid sm:grid-cols-2 gap-6 text-left">
      <a
        href="https://github.com/a2al/a2al/releases"
        target="_blank"
        rel="noopener"
        class="p-6 rounded-xl border border-border hover:border-accent/40 bg-surface/60 transition block group"
      >
        <div class="text-accent font-bold text-xs uppercase mb-2">{tr.home.actionCard1Eyebrow}</div>
        <h4 class="text-xl font-bold text-white mb-2 group-hover:text-accent transition">{tr.home.actionCard1Title}</h4>
        <p class="text-xs text-text-secondary leading-relaxed">{tr.home.actionCard1Desc}</p>
      </a>

      <a
        href={d('/docs/user/getting-started')}
        class="p-6 rounded-xl border border-border hover:border-accent/40 bg-surface/60 transition block group"
      >
        <div class="text-accent font-bold text-xs uppercase mb-2">{tr.home.actionCard2Eyebrow}</div>
        <h4 class="text-xl font-bold text-white mb-2 group-hover:text-accent transition">{tr.home.actionCard2Title}</h4>
        <p class="text-xs text-text-secondary leading-relaxed">{tr.home.actionCard2Desc}</p>
      </a>
    </div>

    <!-- 技术底线与信任背书 -->
    <div class="mt-12 text-sm text-text-secondary/80 flex flex-wrap justify-center items-center gap-x-6 gap-y-3">
      {tr.home.actionTrustPills.map((pill, idx) => (
        <>
          <span>{pill}</span>
          {idx < tr.home.actionTrustPills.length - 1 && <span>·</span>}
        </>
      ))}
    </div>

    <!-- 尾声收口：核心信条（作为协议注脚压舱石，工业极客质感） -->
    <div class="mt-20 pt-12 border-t border-border/40 max-w-2xl mx-auto space-y-3">
      <p class="text-sm sm:text-base text-text-secondary/80 font-normal leading-relaxed">
        {tr.home.creedLine1}
      </p>
      <p class="text-sm sm:text-base text-text-secondary/80 font-normal leading-relaxed">
        {tr.home.creedLine2}
      </p>
      <div class="pt-3 text-[11px] tracking-widest text-accent/70 uppercase font-mono">
        {tr.home.creedSub}
      </div>
    </div>
  </div>
</section>

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "A2AL",
  "description": tr.meta.homeDescription,
  "url": "https://a2al.org",
  "downloadUrl": "https://github.com/a2al/a2al/releases",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Linux, macOS, Windows",
  "inLanguage": tr.htmlLang,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "keywords": "AI agent, agent discovery, decentralized networking, MCP, sovereign identity, peer-to-peer, agent protocol"
})} />

<!-- 前端微交互脚本 -->
<script>
  function setupCopyActions() {
    // 复制 Prompt 按钮
    const promptBtn = document.getElementById('copy-hero-prompt');
    if (promptBtn) {
      const origText = promptBtn.querySelector('.btn-text')?.textContent || '';
      promptBtn.addEventListener('click', () => {
        const text = promptBtn.getAttribute('data-prompt') || '';
        const copied = promptBtn.getAttribute('data-copied') || 'Copied';
        navigator.clipboard.writeText(text).then(() => {
          const span = promptBtn.querySelector('.btn-text');
          if (span) span.textContent = copied;
          setTimeout(() => {
            if (span) span.textContent = origText;
          }, 2500);
        });
      });
    }

    // 复制 CLI 命令按钮
    const cliBtn = document.getElementById('copy-cli-btn');
    if (cliBtn) {
      const origText = cliBtn.querySelector('.btn-text')?.textContent || '';
      cliBtn.addEventListener('click', () => {
        const cmd = cliBtn.getAttribute('data-cmd') || '';
        const copied = cliBtn.getAttribute('data-copied') || 'Copied';
        navigator.clipboard.writeText(cmd).then(() => {
          const span = cliBtn.querySelector('.btn-text');
          if (span) span.textContent = copied;
          setTimeout(() => {
            if (span) span.textContent = origText;
          }, 2500);
        });
      });
    }
  }

  // 页面初次加载和 Astro view transitions
  setupCopyActions();
  document.addEventListener('astro:page-load', setupCopyActions);
</script>
